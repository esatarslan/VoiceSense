<Window x:Class="VoiceSense.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceSense.UI"
        mc:Ignorable="d"
        Title="VoiceSense - Premium AI Voice Cloning" Height="750" Width="1050" 
        WindowStartupLocation="CenterScreen" Background="#0F172A" FontFamily="Segoe UI">
    
    <Window.Resources>
        <!-- Premium Button Style -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Wrap everything in a ScrollViewer so nothing EVER gets squeezed or hidden on smaller screens -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Step 1 -->
                <RowDefinition Height="Auto"/> <!-- Step 2 -->
                <RowDefinition Height="Auto"/> <!-- Step 3 -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="VoiceSense Studio" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#6366F1" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Professional Local Voice Cloning AI" FontSize="15" Foreground="#94A3B8" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Step 1: Voice Configuration (Row 1) -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Header -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="#6366F1" Margin="0,0,10,0"/>
                        <TextBlock Text="Voice Configuration" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                    </StackPanel>

                    <!-- Left Column: Voice File -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Select Reference Audio" FontWeight="SemiBold" Foreground="#E2E8F0" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock Text="Upload a clean 10-15s audio sample of the voice (.wav)." TextWrapping="Wrap" Foreground="#94A3B8" Margin="0,0,0,15" FontSize="13"/>

                        <Button x:Name="BtnSelectVoice" Content="Select Audio File" Style="{StaticResource SecondaryButton}" Click="BtnSelectVoice_Click" HorizontalAlignment="Left" Width="200" Height="35"/>
                        
                        <TextBlock x:Name="TxtSelectedVoice" Text="No file selected." Foreground="#10B981" FontWeight="Medium" Margin="0,15,0,0" TextWrapping="Wrap" FontSize="13"/>
                    </StackPanel>

                    <!-- Right Column: Ref Text -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Reference Transcript" FontWeight="SemiBold" Foreground="#E2E8F0" FontSize="14"/>
                            <TextBlock Text=" (Recommended)" Foreground="#10B981" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Type EXACTLY what is spoken in the reference audio to guarantee perfect cloning fluency." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,15" TextWrapping="Wrap"/>
                        
                        <Border Background="#0B1120" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                            <TextBox x:Name="TxtRefText" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" Padding="12" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Step 2: Text to Generate (Row 2) -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="2" FontSize="18" FontWeight="Bold" Foreground="#6366F1" Margin="0,0,10,0"/>
                        <TextBlock Text="Text to Generate" FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                    </StackPanel>
                    
                    <!-- HEIGHT is explicitly set, and it will NEVER be squeezed thanks to the outer ScrollViewer -->
                    <Border Grid.Row="1" Background="#0B1120" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                        <TextBox x:Name="TxtInputText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                 Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" Padding="12" FontSize="14"
                                 Height="100" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 Text="Hello! With this application, I can easily clone my voice using just a short sample, and have it read anything I type."/>
                    </Border>
                </Grid>
            </Border>

            <!-- Step 3: Action & Output (Row 3) -->
            <Border Grid.Row="3" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="BtnGenerate" Grid.Column="0" Content="3. Generate Voice" Style="{StaticResource PrimaryButton}" Width="220" Height="50" Click="BtnGenerate_Click"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0">
                        <TextBlock x:Name="TxtStatus" Text="System is ready." Foreground="#94A3B8" Margin="0,0,0,8" FontSize="14"/>
                        <ProgressBar x:Name="ProgressBarStatus" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#6366F1" Background="#334155" BorderThickness="0">
                            <ProgressBar.Resources>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <Border x:Name="PART_Track" CornerRadius="3">
                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                                                    </Border>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnPlay" Content="▶ Play Audio" Style="{StaticResource SecondaryButton}" Width="120" Margin="0,0,15,0" Foreground="#10B981" Click="BtnPlay_Click" IsEnabled="False"/>
                        <Button x:Name="BtnSave" Content="💾 Export" Style="{StaticResource SecondaryButton}" Width="120" Click="BtnSave_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
